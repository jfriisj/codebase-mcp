{
    "servers": {
        "code-manager": {
            "command": "docker",
            "args": [
                "run",
                "--rm",
                "-i",
                "--name",
                "mcp-code-manager-${workspaceFolderBasename}",
                "-p",
                "6789:6789",
                "-e",
                "GEMINI_API_KEY={{GEMINI_API_KEY}}",
                "-e",
                "GEMINI_MODEL=gemini-2.5-flash",
                "-e",
                "API_HOST=127.0.0.1",
                "-e",
                "API_PORT=6789",
                "-v",
                "${workspaceFolder}:/app",
                "ghcr.io/jfriisj/codebase-mcp:sha-bcb96d7"
            ]
        }
    }
}
